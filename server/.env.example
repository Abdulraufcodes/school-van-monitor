NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/school_van_monitor
# Database integration tests require a separate database ending in _test. Never copy MONGODB_URI here.
MONGODB_TEST_URI=
JWT_ACCESS_SECRET=

LOCATION_STALE_THRESHOLD_SECONDS=
PICKUP_ALERT_RADIUS_METERS=500


SEED_SCHOOL_NAME=
SEED_SCHOOL_EMAIL=
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Local development only; use a private value of at least 12 characters.
DEV_DEMO_PASSWORD=replace-with-a-local-development-only-password
DEMO_GPS_SIMULATOR_ENABLED=false
# Optional local API origin; defaults to localhost using PORT or 5000.
DEMO_GPS_API_URL=
DEMO_GPS_ROUTE_DURATION_MINUTES=5
DEMO_GPS_INTERVAL_MS=7000
DEMO_GPS_STOP_DURATION_MS=17000

SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

OTP_HASH_SECRET=
